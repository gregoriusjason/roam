# Add your OpenAI key here on the server, then restart the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: a stable, random session signing secret (32+ characters).
# If blank, a random local secret is generated in ignored instance/.session-secret.
FLASK_SECRET_KEY=
HOST=0.0.0.0
PORT=5050
FLASK_DEBUG=false
COOKIE_SECURE=false
# For phone testing over a LAN: FLASK_SSL_ADHOC=true, or set a trusted cert/key pair.
FLASK_SSL_ADHOC=false
FLASK_SSL_CERT=
FLASK_SSL_KEY=

# Local accounts work immediately. Choose supabase to use the existing integration.
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_KEY=

# Optional service overrides for a larger deployment.
# DATABASE_PATH=/absolute/path/to/roam.sqlite3
GEOCODER_URL=https://photon.komoot.io/api/
WALKING_ROUTER_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
OVERPASS_URL=https://overpass.private.coffee/api/interpreter
