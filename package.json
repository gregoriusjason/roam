{
  "name": "roam-reverse-tour-guide",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/main.css -o ./static/dist/main.css --minify",
    "build:js": "node scripts/build-js.cjs",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./static/src/main.css -o ./static/dist/main.css --watch",
    "test:browser": "playwright test",
    "start": ".venv/bin/python app.py"
  },
  "dependencies": {
    "htmx.org": "2.0.11",
    "leaflet": "^1.9.4",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0"
  }
}
